# .env.example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# ============ BOT CONFIG ============
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
DATABASE_PATH=gigs_archive.db
DEBUG_MODE=true

# ============ CHAT IDS ============
# Get these from @userinfobot or /chat command
MAIN_CHANNEL_ID=-1234567890123
MODERATION_CHAT_ID=-1234567890
SUMMARY_CHANNEL_ID=-1234567890123
TEST_CHANNEL_ID=-1234567890123

# ============ ADMIN IDS ============
# Your Telegram user ID(s) - comma separated
ADMIN_IDS=[1234567890,0987654321]

# ============ PRIVACY POLICY ============
# Update version to force users to re-accept
PRIVACY_POLICY_VERSION=1.0

# How often (minutes) public page visits may refresh posters_web.db from gigs_archive.db.
# 0 = only on app startup and via the admin "Sync" button.
WEB_SYNC_MIN_INTERVAL=5

# ============ Site meta (SEO) ============
# Short brand name shown in search results (<title>, og:site_name).
SITE_NAME=GigsArchive
# Meta description for search-engine snippets (Google/Yandex).
SITE_DESCRIPTION=GigsArchive — все концерты на одной стене: афиши, которые публикует сообщество через Telegram-бота, собраны, проверены и сохранены.

# ============ SEO (Yandex Search) ============
# Absolute public origin of the site, used to build /sitemap.xml and /robots.txt.
# Example: SITE_URL=https://gigs-archive.ru
# If left empty, the Host header of each request is used instead.
SITE_URL=
